# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Database (PostgreSQL 17)
# 1. MIGRATION_DATABASE_URL: Superuser/owner used strictly for running migrations
MIGRATION_DATABASE_URL="postgresql://pos_admin:pos_secret@localhost:5432/universal_pos?schema=public"
MIGRATION_TEST_DATABASE_URL="postgresql://pos_admin:pos_secret@localhost:5432/universal_pos_test?schema=public"

# 2. DATABASE_URL: Non-superuser runtime login user (NOINHERIT, zero direct table privileges)
DATABASE_URL="postgresql://pos_runtime:pos_runtime_secret@localhost:5432/universal_pos?schema=public"

# 3. TEST_DATABASE_URL: Dedicated test database (must end with _test)
TEST_DATABASE_URL="postgresql://pos_runtime:pos_runtime_secret@localhost:5432/universal_pos_test?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_ACCESS_SECRET="super-secret-access-key-change-me-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-me-in-production-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
