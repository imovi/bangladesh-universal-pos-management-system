}

model StockTransfer {
  id                  String              @id @default(uuid(7)) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  transferNumber      String              @map("transfer_number")
  sourceBranchId      String              @map("source_branch_id") @db.Uuid
  destinationBranchId String              @map("destination_branch_id") @db.Uuid
  status              String              @default("draft") // draft, sent, received, cancelled
  sentAt              DateTime?           @map("sent_at")
  receivedAt          DateTime?           @map("received_at")
  notes               String?
  createdByUserId     String              @map("created_by_user_id") @db.Uuid
  sentByUserId        String?             @map("sent_by_user_id") @db.Uuid
  receivedByUserId    String?             @map("received_by_user_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceBranch        Branch              @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranch   Branch              @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  createdByUser       User                @relation("TransferCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sentByUser          User?               @relation("TransferSentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)
  receivedByUser      User?               @relation("TransferReceivedByUser", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  items               StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@index([status])
  @@index([createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  transferId      String         @map("transfer_id") @db.Uuid
  variantId       String         @map("variant_id") @db.Uuid
  sentQty         Decimal        @map("sent_qty") @db.Decimal(14, 3)
  receivedQty     Decimal?       @map("received_qty") @db.Decimal(14, 3)
  lossQty         Decimal        @default(0) @map("loss_qty") @db.Decimal(14, 3)
  lossReason      String?        @map("loss_reason")
  createdAt       DateTime       @default(now()) @map("created_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer        StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([transferId])
  @@index([variantId])
  @@map("stock_transfer_items")
}

model TransferCounter {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  dateKey   String   @map("date_key")
  lastSeq   Int      @default(0) @map("last_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dateKey])
  @@index([tenantId])
  @@map("transfer_counters")
}





