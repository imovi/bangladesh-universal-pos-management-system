generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

model Tenant {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String
  slug         String        @unique
  businessType String        @map("business_type")
  status       String        @default("active")
  settings     Json          @default("{}")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  branches     Branch[]
  users        User[]
  roles        Role[]
  featureFlags FeatureFlag[]
  auditLogs    AuditLog[]
  categories   Category[]
  brands       Brand[]
  collections  Collection[]
  taxClasses   TaxClass[]
  products     Product[]
  variants     ProductVariant[]
  stockMovements StockMovement[]
  stockLevels    StockLevel[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptItems  GoodsReceiptItem[]
  supplierPayments   SupplierPayment[]
  customers          Customer[]
  registers          Register[]
  shifts             Shift[]
  cashMovements      CashMovement[]
  sales              Sale[]
  saleItems          SaleItem[]
  salePayments       SalePayment[]
  receiptCounters    ReceiptCounter[]
  documentCounters   DocumentCounter[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userBranches   UserBranch[]
  stockMovements StockMovement[]
  stockLevels    StockLevel[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  registers      Register[]
  shifts         Shift[]
  sales          Sale[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String
  phone        String?
  name         String
  passwordHash String    @map("password_hash")
  pinHash      String?   @map("pin_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles     UserRole[]
  userBranches  UserBranch[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  shifts        Shift[]
  salesCreated  Sale[]         @relation("SaleCashier")
  salesVoided   Sale[]         @relation("SaleVoidedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               String
  isSystem           Boolean  @default(false) @map("is_system")
  maxDiscountPercent Int      @default(0) @map("max_discount_percent")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model UserBranch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([tenantId])
  @@map("user_branches")
}

model RefreshToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash")
  deviceLabel String?   @map("device_label")
  revokedAt   DateTime? @map("revoked_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model FeatureFlag {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("feature_flags")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([tenantId])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("brands")
}

model Collection {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("collections")
}

model TaxClass {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  rateBp    Int       @map("rate_bp")
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("tax_classes")
}

model Product {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  name         String
  description  String?
  categoryId   String?          @map("category_id") @db.Uuid
  brandId      String?          @map("brand_id") @db.Uuid
  collectionId String?          @map("collection_id") @db.Uuid
  taxClassId   String?          @map("tax_class_id") @db.Uuid
  isActive     Boolean          @default(true) @map("is_active")
  customFields Json             @default("{}") @map("custom_fields")
  trackingMode String           @default("none") @map("tracking_mode")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand      Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  collection Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  taxClass   TaxClass?        @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  options    ProductOption[]
  variants   ProductVariant[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([brandId])
  @@index([collectionId])
  @@map("products")
}

model ProductOption {
  id        String               @id @default(uuid(7)) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  productId String               @map("product_id") @db.Uuid
  name      String
  position  Int                  @default(0)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, name])
  @@index([tenantId])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id                  String               @id @default(uuid(7)) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  optionId            String               @map("option_id") @db.Uuid
  value               String
  position            Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at")

  option              ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantOptionValues VariantOptionValue[]

  @@unique([optionId, value])
  @@index([tenantId])
  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id           String               @id @default(uuid(7)) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  productId    String               @map("product_id") @db.Uuid
  sku          String
  priceMinor   BigInt               @map("price_minor")
  costMinor    BigInt               @default(0) @map("cost_minor")
  reorderLevel Decimal              @default(0) @map("reorder_level") @db.Decimal(14, 3)
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues   VariantOptionValue[]
  barcodes       VariantBarcode[]
  stockMovements StockMovement[]
  stockLevels    StockLevel[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  saleItems          SaleItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model VariantOptionValue {
  id            String             @id @default(uuid(7)) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  variantId     String             @map("variant_id") @db.Uuid
  optionId      String             @map("option_id") @db.Uuid
  optionValueId String             @map("option_value_id") @db.Uuid

  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionId])
  @@index([tenantId])
  @@index([variantId])
  @@map("variant_option_values")
}

model VariantBarcode {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  barcode   String
  createdAt DateTime       @default(now()) @map("created_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([variantId])
  @@index([barcode])
  @@map("variant_barcodes")
}

model StockMovement {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  branchId      String         @map("branch_id") @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  qtyDelta      Decimal        @map("qty_delta") @db.Decimal(14, 3)
  type          String
  unitCostMinor BigInt         @default(0) @map("unit_cost_minor")
  refType       String?        @map("ref_type")
  refId         String?        @map("ref_id")
  reason        String?
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  occurredAt    DateTime       @default(now()) @map("occurred_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@index([variantId])
  @@index([type])
  @@index([occurredAt])
  @@map("stock_movements")
}

model StockLevel {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  branchId  String         @map("branch_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  qty       Decimal        @default(0) @db.Decimal(14, 3)
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, variantId])
  @@index([tenantId])
  @@index([branchId])
  @@index([variantId])
  @@map("stock_levels")
}

model Supplier {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([tenantId])
  @@index([name])
  @@index([phone])
  @@map("suppliers")
}

model PurchaseOrder {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  supplierId          String    @map("supplier_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  poNumber            String    @map("po_number")
  status              String    @default("draft")
  totalEstimatedMinor BigInt    @default(0) @map("total_estimated_minor")
  notes               String?
  orderedAt           DateTime? @map("ordered_at")
  expectedAt          DateTime? @map("expected_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  qtyOrdered      Decimal  @map("qty_ordered") @db.Decimal(14, 3)
  qtyReceived     Decimal  @default(0) @map("qty_received") @db.Decimal(14, 3)
  unitCostMinor   BigInt   @map("unit_cost_minor")
  totalMinor      BigInt   @map("total_minor")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([variantId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  grnNumber        String   @map("grn_number")
  purchaseOrderId  String?  @map("purchase_order_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  receivedByUserId String?  @map("received_by_user_id") @db.Uuid
  notes            String?
  receivedAt       DateTime @default(now()) @map("received_at")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items         GoodsReceiptItem[]

  @@unique([tenantId, grnNumber])
  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([branchId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  goodsReceiptId      String   @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String?  @map("purchase_order_item_id") @db.Uuid
  variantId           String   @map("variant_id") @db.Uuid
  qtyReceived         Decimal  @map("qty_received") @db.Decimal(14, 3)
  unitCostMinor       BigInt   @map("unit_cost_minor")
  createdAt           DateTime @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  variant           ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([variantId])
  @@map("goods_receipt_items")
}

model SupplierPayment {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  supplierId    String   @map("supplier_id") @db.Uuid
  amountMinor   BigInt   @map("amount_minor")
  paymentMethod String   @map("payment_method")
  reference     String?
  notes         String?
  paidAt        DateTime @default(now()) @map("paid_at")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([supplierId])
  @@index([paidAt])
  @@map("supplier_payments")
}

model Customer {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  phone           String
  email           String?
  address         String?
  notes           String?
  totalSpentMinor BigInt   @default(0) @map("total_spent_minor")
  totalVisits     Int      @default(0) @map("total_visits")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  Sale[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Register {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  code      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts Shift[]
  receiptCounters ReceiptCounter[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId])
  @@index([branchId])
  @@map("registers")
}

model Shift {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  registerId          String    @map("register_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  cashierUserId       String    @map("cashier_user_id") @db.Uuid
  status              String    @default("open")
  openingCashMinor    BigInt    @map("opening_cash_minor")
  closingCashMinor    BigInt?   @map("closing_cash_minor")
  expectedCashMinor   BigInt?   @map("expected_cash_minor")
  cashDifferenceMinor BigInt?   @map("cash_difference_minor")
  notes               String?
  openedAt            DateTime  @default(now()) @map("opened_at")
  closedAt            DateTime? @map("closed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register      Register       @relation(fields: [registerId], references: [id], onDelete: Restrict)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashierUser   User           @relation(fields: [cashierUserId], references: [id], onDelete: Restrict)
  cashMovements CashMovement[]
  sales         Sale[]

  @@index([tenantId])
  @@index([registerId])
  @@index([branchId])
  @@index([cashierUserId])
  @@index([status])
  @@map("shifts")
}

model CashMovement {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  shiftId     String   @map("shift_id") @db.Uuid
  type        String
  amountMinor BigInt   @map("amount_minor")
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([shiftId])
  @@index([type])
  @@map("cash_movements")
}

model Sale {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  invoiceNumber    String    @map("invoice_number")
  shiftId          String    @map("shift_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  cashierUserId    String    @map("cashier_user_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  status           String    @default("completed")
  subtotalMinor    BigInt    @map("subtotal_minor")
  discountMinor    BigInt    @default(0) @map("discount_minor")
  taxMinor         BigInt    @default(0) @map("tax_minor")
  totalMinor       BigInt    @map("total_minor")
  paidMinor        BigInt    @map("paid_minor")
  changeMinor      BigInt    @default(0) @map("change_minor")
  notes            String?
  voidReason       String?   @map("void_reason")
  voidedAt         DateTime? @map("voided_at")
  voidedByUserId   String?   @map("voided_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift       Shift         @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashierUser User          @relation("SaleCashier", fields: [cashierUserId], references: [id], onDelete: Restrict)
  voidedUser  User?         @relation("SaleVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  payments    SalePayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([shiftId])
  @@index([branchId])
  @@index([cashierUserId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id                     String         @id @default(uuid(7)) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  saleId                 String         @map("sale_id") @db.Uuid
  variantId              String         @map("variant_id") @db.Uuid
  originalUnitPriceMinor BigInt?        @map("original_unit_price_minor")
  unitPriceMinor         BigInt         @map("unit_price_minor")
  unitCostMinor  BigInt         @map("unit_cost_minor")
  quantity       Decimal        @db.Decimal(14, 3)
  subtotalMinor  BigInt         @map("subtotal_minor")
  discountMinor  BigInt         @default(0) @map("discount_minor")
  taxRateBp      Int            @default(0) @map("tax_rate_bp")
  taxMinor       BigInt         @default(0) @map("tax_minor")
  totalMinor     BigInt         @map("total_minor")
  createdAt      DateTime       @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

model SalePayment {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  saleId        String   @map("sale_id") @db.Uuid
  paymentMethod String   @map("payment_method")
  amountMinor   BigInt   @map("amount_minor")
  reference     String?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@index([paymentMethod])
  @@map("sale_payments")
}

model ReceiptCounter {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  registerId String   @map("register_id") @db.Uuid
  dateKey    String   @map("date_key")
  lastSeq    Int      @default(0) @map("last_seq")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register Register @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, registerId, dateKey])
  @@index([tenantId])
  @@index([registerId])
  @@map("receipt_counters")
}

model DocumentCounter {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  docType   String   @map("doc_type")
  dateKey   String   @map("date_key")
  lastSeq   Int      @default(0) @map("last_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, docType, dateKey])
  @@index([tenantId])
  @@map("document_counters")
}



