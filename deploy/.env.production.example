# Domain name for Caddy automatic HTTPS (or localhost for local testing)
DOMAIN=localhost

# Application runtime environment (must be production)
NODE_ENV=production

# Internal port for API service
PORT=4000

# Base public URL for API accessed from browser (must match domain)
NEXT_PUBLIC_API_URL=https://${DOMAIN}/api/v1

# Allowed CORS origins (comma-separated, explicit domains only, no wildcards)
CORS_ORIGINS=https://${DOMAIN}

# Database superuser/owner name (used strictly by migrate and backup services)
POSTGRES_USER=pos_admin

# Database superuser password (generate with: node scripts/gen-secrets.cjs)
POSTGRES_PASSWORD=replace-with-generated-postgres-password

# Production database name
POSTGRES_DB=universal_pos

# Restricted non-superuser runtime database role (used by api service)
POSTGRES_RUNTIME_USER=pos_runtime

# Restricted runtime role password (generate with: node scripts/gen-secrets.cjs)
POSTGRES_RUNTIME_PASSWORD=replace-with-generated-runtime-password

# PostgreSQL runtime connection string (used by api service)
DATABASE_URL=postgresql://${POSTGRES_RUNTIME_USER}:${POSTGRES_RUNTIME_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public&connection_limit=30

# PostgreSQL migration connection string (used only by migrate service)
MIGRATION_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Redis cache and throttler connection URL (internal service)
REDIS_URL=redis://redis:6379

# JWT access secret (min 32 bytes; generate with: node scripts/gen-secrets.cjs)
JWT_ACCESS_SECRET=replace-with-generated-jwt-access-secret-min-32-chars

# JWT access token lifetime
JWT_ACCESS_EXPIRES_IN=15m

# JWT refresh secret (min 32 bytes; generate with: node scripts/gen-secrets.cjs)
JWT_REFRESH_SECRET=replace-with-generated-jwt-refresh-secret-min-32-chars

# JWT refresh token lifetime
JWT_REFRESH_EXPIRES_IN=30d

# Rate limiting window in seconds
RATE_LIMIT_TTL=60

# Maximum requests per rate limiting window per IP
RATE_LIMIT_LIMIT=100
