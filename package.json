{
  "name": "universal-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant, offline-first universal POS platform for Bangladesh",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "backup:now": "tsx scripts/backup.ts",
    "restore:drill": "tsx scripts/restore.ts",
    "db:reset:dev": "tsx scripts/reset-dev-db.ts",
    "db:reset:e2e": "tsx scripts/setup-e2e-db.ts",
    "platform-admin:create": "tsx scripts/create-platform-admin.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  }
}
